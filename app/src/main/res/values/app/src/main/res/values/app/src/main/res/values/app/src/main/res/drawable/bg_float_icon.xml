<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <gradient
                android:type="sweep"
                android:startColor="#8B5CF6"
                android:centerColor="#3B82F6"
                android:endColor="#22D3EE"
                android:useLevel="false" />
        </shape>
    </item>
    <item android:top="3dp" android:bottom="3dp" android:left="3dp" android:right="3dp">
        <shape android:shape="oval">
            <gradient
                android:type="linear"
                android:angle="135"
                android:startColor="#1A1035"
                android:endColor="#0D1B3D" />
        </shape>
    </item>
</layer-list>
